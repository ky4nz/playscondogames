# ============================================
# playscondogames — Contoh Environment Variable
# Copy ke .env untuk lokal, atau isi di Vercel:
# Project → Settings → Environment Variables
# ============================================

# WAJIB — URL PostgreSQL.
# Lokal (sandbox):      postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Vercel/Neon (contoh): postgresql://user:pass@ep-xxxx.ap-southeast-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# WAJIB di production — kunci hash password & token iframe.
# Isi string acak panjang, JANGAN sama antar project.
# Contoh generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_PEPPER=ganti-dengan-string-acak-minimal-32-karakter
